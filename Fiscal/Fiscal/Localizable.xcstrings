          "stringUnit" : {
            "state" : "translated",
            "value" : "Com todas as urnas apuradas, %1$@ terminou em primeiro com %2$@ dos votos válidos."
          }
        }
      }
    },
    "Without Apple Intelligence, Fiscal reads names, parties, states, topics and bill numbers. You can also pin pieces by hand." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem a Apple Intelligence, o Fiscal lê nomes, partidos, estados, temas e números de projetos. Você também pode fixar as peças à mão."
          }
        }
      }
    },
