    "Fiscal" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiscal"
          }
        }
      },
      "shouldTranslate" : false
    },
    "Fiscal adapts the order, the highlights, the colors and the art. The facts are the same for everyone." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fiscal adapta a ordem, os destaques, as cores e a arte. Os fatos são os mesmos para todo mundo."
          }
        }
      }
    },
    "Fiscal card" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Card do Fiscal"
          }
        }
      }
    },
    "Fiscal couldn't reach the public data now. Try again in a moment." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fiscal não conseguiu acessar os dados públicos agora. Tente de novo daqui a pouco."
          }
        }
      }
    },
    "Fiscal doesn't ask who you are and doesn't measure what you do." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fiscal não pergunta quem você é e não mede o que você faz."
          }
        }
      }
    },
    "Fiscal downloads it again on the next update with a connection." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fiscal baixa de novo na próxima atualização com conexão."
          }
        }
      }
    },
    "Fiscal follows the light and dark setting of your device." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fiscal segue o ajuste claro ou escuro do seu aparelho."
          }
        }
      }
    },
    "Fiscal grows by word of mouth, one friend at a time." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fiscal cresce no boca a boca, um amigo de cada vez."
          }
        }
      }
    },
    "Fiscal has no data for this filter in the latest update." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fiscal não tem dados para este filtro na última carga."
          }
        }
      }
    },
    "Fiscal keeps this look whatever your device uses." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fiscal mantém este visual, seja qual for o ajuste do aparelho."
          }
        }
      }
    },
    "Fiscal puts the same numbers side by side, in columns of the same width, with no score or ranking." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fiscal põe os mesmos números lado a lado, em colunas da mesma largura, sem nota e sem ranking."
          }
        }
      }
    },
    "Fiscal read names, places and numbers in your question, without AI." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fiscal leu nomes, lugares e números na sua pergunta, sem IA."
          }
        }
      }
    },
    "Fiscal shows only what these bodies publish. When a piece of data is missing, you see a dash, never a zero." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fiscal mostra só o que esses órgãos publicam. Quando falta um dado, aparece um traço, nunca um zero."
          }
        }
      }
    },
    "Fiscal shows the latest vote in Congress as soon as it's published." : {
      "extractionState" : "stale",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fiscal mostra a votação mais recente do Congresso assim que ela é publicada."
          }
        }
      }
    },
    "Fiscal shows what is estimated or missing next to each number." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fiscal mostra o que é estimado ou falta ao lado de cada número."
          }
        }
      }
    },
    "Fiscal stays neutral: topics in the order the data comes." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fiscal fica neutro: temas na ordem em que os dados chegam."
