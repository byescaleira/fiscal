          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiscal"
          }
        }
      },
      "shouldTranslate" : false
    },
    "Fiscal adapts the order, the highlights, the colors and the art. The facts are the same for everyone." : {
      "extractionState" : "stale",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fiscal adapta a ordem, os destaques, as cores e a arte. Os fatos são os mesmos para todo mundo."
          }
        }
      }
    },
    "Fiscal adapts what comes first, the colors, the art and the highlights. The numbers are the same for everyone." : {
      "extractionState" : "stale",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fiscal adapta o que aparece primeiro, as cores, a arte e os destaques. Os números são os mesmos para todo mundo."
          }
        }
      }
    },
