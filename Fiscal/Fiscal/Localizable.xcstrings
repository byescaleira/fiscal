    "Each tab keeps its own place, so you can switch without losing your way." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Tab merkt sich seine Stelle, du kannst wechseln, ohne den Faden zu verlieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada pestaña guarda su lugar, así que puedes cambiar sin perderte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque onglet garde sa place : vous pouvez changer sans vous perdre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni scheda ricorda dove eri, così puoi passare dall'una all'altra senza perderti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各タブは表示位置を覚えているので、切り替えても迷いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 탭은 보던 위치를 기억하므로 전환해도 길을 잃지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada aba guarda onde você parou, então dá para trocar sem se perder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая вкладка запоминает своё место, поэтому можно переключаться, не теряясь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个标签页都会记住自己的位置，切换时不会迷路。"
          }
        }
      }
    },
