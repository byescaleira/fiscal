    },
    "A bill is a text sent to the house to be analyzed, and it only becomes law after being approved in the votes." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma proposta é um texto enviado para a casa analisar, e ela só vira lei depois de aprovada nas votações."
          }
        }
      }
    },
    "A constitutional amendment needs three fifths of the seats voting yes, not just more yes than no." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma emenda à Constituição precisa de três quintos das cadeiras votando Sim, não só de mais Sim do que Não."
          }
        }
      }
    },
    "A dash means the source doesn't publish this number." : {
      "extractionState" : "stale",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
