    },
    "A fact check that names someone isn't always about something that person said." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma checagem que cita alguém nem sempre é sobre algo que essa pessoa disse."
          }
        }
      }
    },
    "A federal deputy's salary equals %@ minimum wages and %@ times the average labor income in Brazil." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O subsídio de um deputado federal equivale a %1$@ salários mínimos e a %2$@ vezes a renda média do trabalho no Brasil."
          }
        }
      }
    },
    "A federal deputy's salary equals %@ minimum wages." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O subsídio de um deputado federal equivale a %@ salários mínimos."
          }
        }
      }
    },
    "A missing signal doesn't count as zero: repercussion is the weighted average of only the signals measured in this load. With no signal measured, the weight is the impact alone, and the app says so." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinal ausente não conta como zero: a repercussão é a média ponderada só dos sinais medidos nesta carga. Sem nenhum sinal medido, o peso é só o impacto, e o app avisa."
          }
        }
      }
    },
    "A new Fiscal is available" : {
