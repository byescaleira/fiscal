      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontem"
          }
        }
      }
    },
    "Your choice stays only on this iPhone. It does not go to any server, it is not in iCloud or in backups, it is not shared and Fiscal does not know what it is." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua escolha fica só neste iPhone. Ela não vai para nenhum servidor, não entra no iCloud nem em backup, não é compartilhada e o Fiscal não sabe qual é."
          }
        }
      }
    },
    "YOUR CITY" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SUA CIDADE"
          }
        }
      }
    },
    "Your Data Stays Yours" : {
      "localizations" : {
        "pt-BR" : {
