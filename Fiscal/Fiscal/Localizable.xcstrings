    "This version is no longer supported. Update to keep using Fiscal. Your data stays on your device and you can export it now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Version wird nicht mehr unterstützt. Aktualisiere, um Fiscal weiter zu nutzen. Deine Daten bleiben auf deinem Gerät und du kannst sie jetzt exportieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión ya no es compatible. Actualiza para seguir usando Fiscal. Tus datos siguen en tu dispositivo y puedes exportarlos ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version n’est plus prise en charge. Mettez à jour pour continuer à utiliser Fiscal. Vos données restent sur votre appareil et vous pouvez les exporter dès maintenant."
          }
