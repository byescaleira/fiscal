          }
        }
      }
    },
    "Who you follow stays on this device." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem você segue fica só neste aparelho."
          }
        }
      }
    },
    "Who you follow syncs only through your own iCloud account." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem você segue sincroniza só pela sua própria conta do iCloud."
          }
        }
      }
    },
    "Who you support" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem você apoia"
          }
        }
      }
    },
    "Who you support never goes to a server, a log or a share card." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem você apoia nunca vai para um servidor, um log ou um card de compartilhar."
          }
        }
      }
    },
    "Who you support stays only on this iPhone. It does not go to any server, it is not in iCloud, backups, notifications or shared images, and Fiscal does not know who it is." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem você apoia fica só neste iPhone. Não vai para nenhum servidor, não entra no iCloud, em backup, em notificação nem em imagem compartilhada, e o Fiscal não sabe quem é."
          }
        }
      }
    },
    "Who you support, your topics and your look leave this iPhone for good. Then Fiscal asks for them again." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem você apoia, seus temas e seu visual saem deste iPhone de vez. Depois o Fiscal pergunta de novo."
          }
        }
      }
    },
    "Who you support, your topics and your look stay on this device, outside iCloud and backups." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem você apoia, seus temas e seu visual ficam neste aparelho, fora do iCloud e do backup."
          }
        }
      }
    },
