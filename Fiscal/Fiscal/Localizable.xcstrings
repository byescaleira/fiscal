    "Update for the latest fixes and improvements. It only takes a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiere für die neuesten Fehlerbehebungen und Verbesserungen. Es dauert nur einen Moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza para tener las últimas correcciones y mejoras. Solo toma un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez à jour pour profiter des dernières corrections et améliorations. Cela ne prend qu’un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna per avere le correzioni e i miglioramenti più recenti. Ci vuole solo un attimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新の修正と改善を入手するにはアップデートしてください。すぐに終わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최신 수정 사항과 개선 사항을 받으려면 업데이트하세요. 잠깐이면 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize para ter as correções e melhorias mais recentes. Leva só um instante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновите приложение, чтобы получить последние исправления и улучшения. Это займёт всего минуту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新即可获得最新的修复和改进，只需片刻。"
          }
        }
      }
