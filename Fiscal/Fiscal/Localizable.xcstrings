        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pela lente %@"
          }
        }
      }
    },
    "With the impartial lens, every other lens stays one tap away. Nothing is saved and the numbers do not change." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na lente imparcial, as outras lentes ficam sempre a um toque. Nada é salvo e os números não mudam."
