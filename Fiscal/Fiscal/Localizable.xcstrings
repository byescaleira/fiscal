    "Add the first item and it shows up here, newest first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge den ersten Eintrag hinzu – er erscheint hier, der neueste zuerst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade el primer elemento y aparecerá aquí, del más nuevo al más antiguo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez le premier élément : il apparaît ici, du plus récent au plus ancien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi il primo elemento e comparirà qui, dal più recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の項目を追加すると、新しい順にここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 번째 항목을 추가하면 최신순으로 여기에 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione o primeiro item e ele aparece aqui, do mais novo para o mais antigo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте первый элемент — он появится здесь, сначала самые новые."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加第一个项目后，它会按从新到旧的顺序显示在这里。"
          }
        }
      }
    },
