    "Every device signed in to your Apple Account shows the same data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Gerät mit deinem Apple Account zeigt dieselben Daten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los dispositivos con tu cuenta de Apple muestran los mismos datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque appareil connecté à votre compte Apple affiche les mêmes données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni dispositivo con il tuo Account Apple mostra gli stessi dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じApple Accountでサインインしたすべてのデバイスに同じデータが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 Apple 계정으로 로그인한 모든 기기에 동일한 데이터가 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo aparelho conectado à sua Conta Apple mostra os mesmos dados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все устройства с вашим аккаунтом Apple показывают одни и те же данные."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录同一 Apple 账户的所有设备都会显示相同的数据。"
          }
        }
      }
    },
    "Every message reaches the person who writes the code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Nachricht erreicht die Person, die den Code schreibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada mensaje llega a quien escribe el código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque message arrive à la personne qui écrit le code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni messaggio arriva a chi scrive il codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージはすべて、コードを書いている本人に届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 메시지는 코드를 쓰는 사람에게 바로 전달돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada mensagem chega a quem escreve o código."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждое сообщение попадает к тому, кто пишет код."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每条消息都会直接送到写代码的人手里。"
          }
        }
      }
    },
    "Everything lives on your device and in your iCloud. No account, no servers, no third parties." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bleibt auf deinem Gerät und in deiner iCloud. Kein Konto, keine Server, keine Dritten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo vive en tu dispositivo y en tu iCloud. Sin cuentas, sin servidores, sin terceros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout reste sur votre appareil et dans votre iCloud. Pas de compte, pas de serveurs, pas de tiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto resta sul tuo dispositivo e nel tuo iCloud. Nessun account, nessun server, nessuna terza parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてはデバイスとあなたのiCloudにあります。アカウントもサーバも第三者もありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 데이터는 기기와 내 iCloud에만 있습니다. 계정도, 서버도, 제3자도 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo fica no seu aparelho e no seu iCloud. Sem conta, sem servidores, sem terceiros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё хранится на вашем устройстве и в вашем iCloud. Без аккаунта, серверов и третьих лиц."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切都保存在你的设备和 iCloud 中。无需账户，没有服务器，没有第三方。"
          }
        }
      }
    },
    "Everything starts on the Home tab. Settings keeps the choices that are yours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles beginnt im Tab Start. In den Einstellungen liegen deine eigenen Entscheidungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo empieza en la pestaña Inicio. Ajustes guarda las decisiones que son tuyas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout commence dans l’onglet Accueil. Les Réglages gardent vos choix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto inizia nella scheda Home. Le Impostazioni conservano le tue scelte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてはホームタブから始まります。設定にはあなたの好みが保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 것은 홈 탭에서 시작합니다. 설정에는 나만의 선택이 담겨 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo começa na aba Início. Os Ajustes guardam as escolhas que são suas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё начинается на вкладке «Главная». В настройках хранится ваш выбор."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切从“首页”标签开始。“设置”保存属于你的选择。"
          }
        }
      }
    },
    "Everything syncs through your own iCloud account, nowhere else." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles synchronisiert über dein eigenes iCloud-Konto, sonst nirgends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo se sincroniza con tu propia cuenta de iCloud y con nada más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout se synchronise via votre propre compte iCloud, nulle part ailleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto si sincronizza con il tuo account iCloud, e da nessun’altra parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてあなた自身のiCloudアカウントだけで同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 데이터는 나의 iCloud 계정으로만 동기화됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo sincroniza pela sua própria conta do iCloud, e por nenhum outro lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё синхронизируется только через вашу учётную запись iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有内容只通过你自己的 iCloud 账户同步。"
          }
        }
      }
    },
    "Export Data" : {
      "localizations" : {
