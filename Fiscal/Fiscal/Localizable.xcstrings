        }
      }
    },
    "A dash means the source doesn't publish this number. Each number shows where it comes from." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um traço quer dizer que a fonte não publica esse número. Cada número mostra de onde vem."
          }
        }
      }
    },
    "A day without a bar had no votes on these topics." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dia sem barra não teve votação nestes temas."
