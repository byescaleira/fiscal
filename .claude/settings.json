{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(scripts/verify.sh *)",
      "Bash(scripts/build.sh)",
      "Bash(scripts/build.sh *)",
      "Bash(scripts/test.sh)",
      "Bash(scripts/test.sh *)",
      "Bash(scripts/ui-test.sh)",
      "Bash(scripts/ui-test.sh *)",
      "Bash(scripts/store-test.sh)",
      "Bash(scripts/store-test.sh *)",
      "Bash(scripts/lint.sh)",
      "Bash(scripts/lint.sh *)",
      "Bash(scripts/format.sh)",
      "Bash(scripts/format.sh *)",
      "Bash(scripts/strings.sh)",
      "Bash(scripts/audit.sh)",
      "Bash(scripts/audit.sh *)",
      "Bash(scripts/simulator.sh *)",
      "Bash(python3 scripts/site-i18n.py *)",
      "Bash(node scripts/site-server.mjs)",
      "Bash(node --test *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(ssh *)",
      "Bash(scp *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.p8)"
    ]
  },
  "extraKnownMarketplaces": {
    "byescaleira-workspace": {
      "source": {
        "source": "github",
        "repo": "byescaleira/byescaleira-workspace"
      }
    }
  },
  "enabledPlugins": {
    "byescaleira-workspace@byescaleira-workspace": true
  }
}
