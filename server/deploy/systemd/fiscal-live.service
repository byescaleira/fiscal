[Unit]
Description=Fiscal live refresh (today's agenda and votes) and deploy to Pages
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/fiscal-api
ExecStart=/usr/bin/docker compose --project-directory /opt/fiscal-api --profile jobs run --rm --no-deps -T fiscal-ingest -once live
ExecStart=/usr/bin/docker compose --project-directory /opt/fiscal-api --profile jobs run --rm --no-deps -T fiscal-pages
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
CPUQuota=100%
MemoryMax=256M
OOMScoreAdjust=1000
TimeoutStartSec=9min
